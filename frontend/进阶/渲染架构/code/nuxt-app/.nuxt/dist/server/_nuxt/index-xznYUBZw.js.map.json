{"file":"index-xznYUBZw.js","mappings":";;;;;;;;;;;;;;;;;;;;AAEA,UAAM,EAAE,MAAM,QAAA,KAAY,CAAA,QAAA,SAAA,IAAAA,iBAAA,MAAM;AAAA,MAAS;AAAA;;KAAqB;;;sEAMlDC,eAAAC,MAAA,OAAA,GAAS,KAAK,aAAeD,eAAAC,MAAA,OAAA,GAAS,MAAM;oBAElCA,MAAA,OAAA,GAAS,QAAM,CAApB,MAAC;;;UACC,IAAE,WAAa,EAAE,EAAE;AAAA,QAAA;2BAA9B,CAAsE,GAAAC,QAAAC,UAAA,aAAA;;yBAAhCH,eAAA,EAAE,EAAE,KAAOA,eAAA,EAAE,KAAK;;;gCAAtB,MAACI,gBAAG,EAAE,EAAE,IAAG,MAACA,gBAAG,EAAE,KAAK,GAAA,CAAA;AAAA,cAAA;AAAA;;;;;;;;;;;;;;;;","names":["_withAsyncContext","_ssrInterpolate","_unref","_push","_parent","_toDisplayString"],"sources":["../../../../pages/index.vue"],"sourcesContent":["<script setup lang=\"ts\">\n// 首页：useFetch 在服务端取数（SSR），响应随 HTML 下发，客户端不再重复请求\nconst { data: summary } = await useFetch('/api/orders/summary')\n</script>\n\n<template>\n  <main>\n    <h1>订单中心（Nuxt）</h1>\n    <p>共 {{ summary?.total }} 笔订单，累计 ¥{{ summary?.amount }}</p>\n    <ul>\n      <li v-for=\"o in summary?.orders\" :key=\"o.id\">\n        <NuxtLink :to=\"`/orders/${o.id}`\">#{{ o.id }} {{ o.title }}</NuxtLink>\n      </li>\n    </ul>\n  </main>\n</template>\n"],"version":3}