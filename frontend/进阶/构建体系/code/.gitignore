# 各 lab 的产物目录：每次运行脚本都会重建，不入库
dist/
dist-*/
.wp-cache/

# analyze-lab 的被测源码由 optimize.cjs 自己生成（源码内容写在脚本里）
analyze-lab/src/

# bench 的样本源码由 bench/gen.cjs 生成、bench/run.cjs 每次运行先清空再重建
bench/src/
bench/src-noside/

# Windows 下被仓库文件监视器锁住、rmdir 失败改 rename 丢弃的临时目录（run.cjs 的 safeRemove）
bench/*.trash*

# 各 lab 独立的依赖安装目录
node_modules/
package-lock.json