{
    "name": "build-lab",
    "version": "1.0.0",
    "private": true,
    "description": "构建体系配套实验：编译与 AST / webpack / Vite / Rollup / esbuild 与 Rust 工具链 / 插件 / 产物分析",
    "scripts": {
        "ast": "node ast-lab/parse.cjs && node ast-lab/transform.cjs",
        "ast:plugin": "node ast-lab/custom-plugin.cjs",
        "ast:codemod": "node ast-lab/codemod.cjs",
        "webpack": "webpack --config webpack-lab/webpack.config.cjs",
        "webpack:split": "node webpack-lab/split.cjs",
        "webpack:cache": "node webpack-lab/cache.cjs",
        "rollup:formats": "node rollup-lab/formats.cjs",
        "rollup:plugin": "node rollup-lab/custom-plugin.cjs",
        "rollup:shake": "node rollup-lab/shake.cjs",
        "rollup:side-effects": "node rollup-lab/side-effects.cjs",
        "rollup:external": "node rollup-lab/external.cjs",
        "rollup:hooks": "node rollup-lab/hooks.cjs",
        "rollup:context": "node rollup-lab/context.cjs",
        "rollup:gate": "node rollup-lab/size-gate.cjs",
        "rollup:cjs": "node rollup-lab/cjs.cjs",
        "esbuild": "node esbuild-lab/build.cjs",
        "swc": "node swc-lab/compare.cjs",
        "vite": "node vite-lab/run.cjs",
        "vite:optimize": "vite optimize --force --config vite-lab/vite.config.mjs",
        "vite:assets": "node vite-lab/assets.cjs",
        "vite:plugins": "node vite-lab/plugins.cjs",
        "bench": "node bench/run.cjs",
        "plugin": "node plugin-lab/three-ways.mjs",
        "plugin:unplugin": "node plugin-lab/unplugin-demo.mjs",
        "plugin:ondemand": "node plugin-lab/import-on-demand.mjs",
        "plugin:ban": "node plugin-lab/ban-api.mjs",
        "analyze": "node analyze-lab/optimize.cjs",
        "mini": "node mini-bundler/bundle.cjs",
        "mini:cycle": "node mini-bundler/bundle.cjs src/cycle/entry.js",
        "mini:tdz": "node mini-bundler/bundle.cjs src/cycle-tdz/entry.js"
    },
    "devDependencies": {
        "@babel/core": "^7.24.0",
        "@babel/generator": "^7.24.0",
        "@babel/parser": "^7.24.0",
        "@babel/preset-env": "^7.24.0",
        "@babel/traverse": "^7.24.0",
        "@babel/types": "^7.24.0",
        "@swc/core": "^1.16.2",
        "acorn": "^8.11.0",
        "esbuild": "^0.28.0",
        "magic-string": "^0.30.0",
        "rollup": "^4.14.0",
        "unplugin": "^3.4.0",
        "vite": "^8.0.0",
        "webpack": "^5.90.0",
        "webpack-cli": "^5.1.0"
    }
}
