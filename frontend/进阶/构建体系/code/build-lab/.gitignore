# 各 lab 的产物目录：每次运行脚本都会重建，不入库
dist/
dist-*/
.wp-cache/

# analyze-lab 的被测源码由 optimize.cjs 自己生成（源码内容写在脚本里）
analyze-lab/src/

# bench 的样本源码由 bench/gen.cjs 生成、bench/run.cjs 每次运行先清空再重建
bench/src/
bench/src-noside/

# 同样是脚本自生成的样本（rollup-lab/external.cjs、vite-lab/assets.cjs、plugins.cjs）
rollup-lab/src-ext/
vite-lab/src-assets/
vite-lab/src-plugins/
