{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "调试 webpack 插件",
            "program": "${workspaceFolder}/node_modules/webpack-cli/bin/cli.js",
            "args": ["--config", "${workspaceFolder}/webpack-lab/webpack.config.cjs", "--env", "debug"],
            "cwd": "${workspaceFolder}",
            "skipFiles": ["<node_internals>/**"],
            "console": "integratedTerminal"
        }
    ]
}
