{
  "name": "monitor-lab",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "监控与稳定性模块配套验证台：零依赖浏览器 SDK（错误/性能/埋点）+ 极简采集端 + Vite/Vue3 SPA 按路由演示上报",
  "scripts": {
    "dev": "vite --config app/vite.config.mjs",
    "build": "vite build --config app/vite.config.mjs",
    "preview": "vite preview --config app/vite.config.mjs",
    "server": "node collector.mjs",
    "start": "vite build --config app/vite.config.mjs && node collector.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^5.4.11",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  }
}