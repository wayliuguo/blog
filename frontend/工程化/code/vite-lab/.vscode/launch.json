{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试 vite build（断点打在 plugins/ 里）",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
            "args": ["build", "--configLoader", "runner"],
            "env": { "DEBUG_VITE": "1" },
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "name": "调试 vite dev",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
            "args": ["dev", "--configLoader", "runner"],
            "env": { "DEBUG_VITE": "1" },
            "console": "integratedTerminal",
            "serverReadyAction": {
                "pattern": "http://localhost:([0-9]+)",
                "uriFormat": "http://localhost:%1",
                "action": "openExternally"
            },
            "skipFiles": ["<node_internals>/**"]
        }
    ]
}
