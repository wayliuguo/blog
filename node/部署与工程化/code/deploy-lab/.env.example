# deploy-lab 环境变量模板
# 复制成 .env.development / .env.production 后填入真实值（不要提交真实值）
# 生成 types/env.d.ts 的脚本会扫描本文件：npm run 01genenvtypes

# 运行环境：development / production / test
NODE_ENV=development

# 应用
APP_NAME=deploy-lab
APP_PORT=3000

# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me

# 日志
LOGGER_LEVEL=info
LOGGER_MAX_FILES=31

# 安全：生产必须换成强随机值
JWT_SECRET=your-jwt-secret-change-me

# 管理后台账号（必填）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# SMTP（新增命名空间的示例）
SMTP_HOST=smtp.example.com
SMTP_PORT: 587
