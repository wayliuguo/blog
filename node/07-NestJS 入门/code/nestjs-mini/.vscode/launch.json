{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug nestjs-mini",
            "program": "${workspaceFolder}/index.ts",
            // 通过 ts-node/register 把 TS 直接跑在 Node 内存里，断点可落在 .ts 源码上
            "runtimeArgs": ["-r", "ts-node/register"],
            "cwd": "${workspaceFolder}",
            "sourceMaps": true,
            "smartStep": true,
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        }
    ]
}
